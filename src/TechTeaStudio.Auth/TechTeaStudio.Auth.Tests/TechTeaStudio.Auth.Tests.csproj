<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0 joined in 0.11.0. It was excluded because EFCore.InMemory 10.x could not sit on
      top of a library compiled against EF Core 9.0; now that both EFCore packages have a real
      net10.0 build against EF Core 10, the mismatch is gone and net10 is the framework the
      consumers actually run on.
    -->
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- A switch that does not cover every case (CS8509) or every null input (CS8655) is an
         error in the tests. The net11.0 union tests rely on it: an exhaustive switch over a
         union must stop compiling the day a case is added. -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8509;CS8655</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="FluentAssertions" Version="6.12.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.7" />
  </ItemGroup>

  <!-- net11.0 runs the stores against EF Core 11: the packages are built against EF Core 10
       (see the EFCore projects), and this is the check that they work on the newer runtime. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TechTeaStudio.Auth\TechTeaStudio.Auth.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.EFCore\TechTeaStudio.Auth.EFCore\TechTeaStudio.Auth.EFCore.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.Swashbuckle\TechTeaStudio.Auth.Swashbuckle\TechTeaStudio.Auth.Swashbuckle.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.OAuth.Abstractions\TechTeaStudio.Auth.OAuth.Abstractions\TechTeaStudio.Auth.OAuth.Abstractions.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.OAuth.EFCore\TechTeaStudio.Auth.OAuth.EFCore\TechTeaStudio.Auth.OAuth.EFCore.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.OAuth.Google\TechTeaStudio.Auth.OAuth.Google\TechTeaStudio.Auth.OAuth.Google.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.OAuth.GitHub\TechTeaStudio.Auth.OAuth.GitHub\TechTeaStudio.Auth.OAuth.GitHub.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.OAuth.Microsoft\TechTeaStudio.Auth.OAuth.Microsoft\TechTeaStudio.Auth.OAuth.Microsoft.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.Providers.Telegram\TechTeaStudio.Auth.Providers.Telegram\TechTeaStudio.Auth.Providers.Telegram.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.OAuthServer\TechTeaStudio.Auth.OAuthServer\TechTeaStudio.Auth.OAuthServer.csproj" />
    <ProjectReference Include="..\..\TechTeaStudio.Auth.OAuthServer.EFCore\TechTeaStudio.Auth.OAuthServer.EFCore\TechTeaStudio.Auth.OAuthServer.EFCore.csproj" />
  </ItemGroup>

</Project>
